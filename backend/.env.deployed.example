# ─── Values injected into the deployed (EKS) backend pod ────────────────────
# WARNING: Never commit actual secrets. Use AWS Secrets Manager / Kubernetes Secrets.
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_VERSION=__APP_VERSION__
LOG_LEVEL=debug

# Database (injected from AWS Secrets Manager / K8s Secret — NOT this file)
DB_HOST=
DB_PORT=3306
DB_NAME=tasktracker_dev
DB_USER=
DB_PASSWORD=
DB_POOL_MAX=5
DB_POOL_MIN=1
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# JWT (injected from K8s Secret — NOT this file)
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# CORS
ALLOWED_ORIGINS=https://yourdomain.com

# Rate Limiting
RATE_LIMIT_MAX=500
